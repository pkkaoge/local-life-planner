# 环境变量配置（复制为 .env 使用）
# 复制命令: cp .env.example .env

# JWT 签名密钥（生产环境必须修改）
JWT_SECRET=dev-jwt-secret-change-in-prod

# 管理员 Token（生产环境必须修改）
ADMIN_TOKEN=dev-admin-token-change-in-prod

# 高德地图 API Key（用于算路和 POI 搜索）
AMAP_ROUTE_KEY=

# 支付方式（manual=手动转账）
PAYMENT_PROVIDER=manual

# 支付宝收款名
ALIPAY_PAYEE_NAME=支付宝收款账户

# 短信服务（dev=开发模式，验证码在响应中返回）
SMS_PROVIDER=dev

# PostgreSQL 数据库连接字符串
DATABASE_URL=postgresql://user:password@localhost:5432/local_life_planner
